    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.56.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "test:e2e": "node e2e/smoke.e2e.mjs",
    "test:e2e:college": "node e2e/college.e2e.mjs",
    "export:check": "EXPO_OFFLINE=1 EXPO_PUBLIC_API_URL=https://example.invalid expo export --platform android --platform ios --output-dir .export-check"
