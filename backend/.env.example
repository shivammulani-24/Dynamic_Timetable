# Copy to backend/.env for local development. NEVER commit real secrets.
ENVIRONMENT=development              # development | test | production
DATABASE_URL=postgresql+psycopg://timetable:timetable_dev@localhost:5432/timetable

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (required in production)
JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Private file storage for uploaded originals (mount a persistent volume in production)
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=15
MAX_PAGES=30

# OCR (Tesseract) and legacy Office conversion (LibreOffice)
OCR_ENABLED=true
TESSERACT_CMD=tesseract
SOFFICE_PATH=soffice

# Worker
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3

# Rate limits (per API process)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# Optional email for invitations / password reset. If unset in development, codes are returned
# in API responses (flagged dev_*) so flows can be demonstrated; never in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional push notifications through Expo's push service
EXPO_PUSH_ENABLED=false

# Production: list explicit origins, e.g. ["https://timetable.college.edu"]
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
